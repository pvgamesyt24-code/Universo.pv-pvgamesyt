<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Universo PV · Anime 1000 Episódios</title>
<meta name="description" content="Vikings: A Lenda do Guerreiro PV — 10 Sagas, 1000 Episódios, 400 Horas. Portal oficial do Universo PV.">
<link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700;800;900&family=Bebas+Neue&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4/fonts/remixicon.css">
<style>
  :root{
    --bg:#04040a;--card:#0a0a18;--card2:#121226;
    --text:#f5f5ff;--muted:#8686a8;
    --accent:#3b82f6;--accent2:#f97316;--accent3:#a855f7;
    --accent4:#ef4444;--accent5:#22c55e;--accent6:#eab308;
    --border:rgba(255,255,255,.06);
  }
  *{box-sizing:border-box;font-family:'Urbanist',system-ui,sans-serif;margin:0;padding:0;}
  html,body{background:radial-gradient(ellipse at top,#0a0a25 0%,#020208 55%);color:var(--text);min-height:100vh;}
  .wrap{padding:24px 8px;display:flex;justify-content:center;}
  .phone{
    width:100%;max-width:420px;background:var(--bg);
    border-radius:42px;overflow:hidden;position:relative;
    box-shadow:0 50px 120px rgba(0,0,0,.85),0 0 0 10px #111118,0 0 0 12px #04040a;
  }
  .notch{position:absolute;top:0;left:50%;transform:translateX(-50%);width:150px;height:34px;background:#000;border-radius:0 0 24px 24px;z-index:80;}
  .sb{display:flex;justify-content:space-between;align-items:center;padding:12px 30px 6px;font-size:13px;font-weight:700;}
  .hero{
    position:relative;padding:18px 18px 16px;
    background:
      radial-gradient(700px 280px at 100% -10%,rgba(234,179,8,.22),transparent 55%),
      radial-gradient(500px 240px at -10% 110%,rgba(168,85,247,.25),transparent 55%),
      linear-gradient(160deg,#08081c 0%,#04040a 100%);
    border-bottom:1px solid var(--border);overflow:hidden;
  }
  .hero::after{
    content:'1000';position:absolute;right:-10px;top:-10px;font-family:'Bebas Neue';font-size:180px;line-height:1;
    background:linear-gradient(180deg,rgba(251,191,36,.25),transparent);
    -webkit-background-clip:text;background-clip:text;color:transparent;pointer-events:none;
  }
  .bebas{font-family:'Bebas Neue',sans-serif;letter-spacing:2px;}
  .macg{
    margin-top:12px;padding:12px;border-radius:14px;position:relative;
    background:linear-gradient(135deg,rgba(251,191,36,.18),rgba(168,85,247,.14));
    border:1px solid rgba(251,191,36,.35);
  }
  .macg::before{
    content:'';position:absolute;top:-50%;right:-15%;width:150px;height:150px;border-radius:50%;
    background:radial-gradient(circle,rgba(251,191,36,.55),transparent 70%);
    filter:blur(8px);animation:pg 3.5s ease-in-out infinite;
  }
  @keyframes pg{50%{opacity:.4;transform:scale(1.2);}}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:12px;text-align:center;}
  .st{padding:8px 3px;border-radius:10px;background:rgba(255,255,255,.04);border:1px solid var(--border);}
  .st b{display:block;font-size:17px;font-weight:900;line-height:1;
    background:linear-gradient(135deg,#fff,#fbbf24);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .st span{font-size:8.5px;color:var(--muted);font-weight:800;letter-spacing:.5px;text-transform:uppercase;}
  .mile{margin:10px 14px 4px;padding:10px 12px;border-radius:12px;background:var(--card);border:1px solid var(--border);}
  .mile-bar{height:7px;border-radius:999px;background:rgba(255,255,255,.07);overflow:hidden;margin-top:6px;}
  .mile-fill{
    height:100%;width:.5%;border-radius:999px;
    background:linear-gradient(90deg,#22c55e,#3b82f6,#a855f7,#f97316,#ef4444,#eab308);
    background-size:400% 100%;animation:fl 10s linear infinite;
  }
  @keyframes fl{to{background-position:400% 0;}}
  .mile-nums{display:flex;justify-content:space-between;font-size:8px;color:var(--muted);font-weight:900;margin-top:4px;letter-spacing:.5px;}
  .tabs{display:flex;padding:0 4px;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none;}
  .tabs::-webkit-scrollbar{display:none;}
  .tab{padding:12px 13px;font-size:12px;font-weight:800;color:var(--muted);cursor:pointer;border-bottom:2.5px solid transparent;white-space:nowrap;transition:all .2s;}
  .tab.active{color:#fff;border-bottom-color:var(--accent6);}
  .grid{padding:12px 10px 100px;display:grid;grid-template-columns:1fr 1fr;gap:7px;}
  .sc{
    position:relative;padding:11px 10px;border-radius:13px;cursor:pointer;transition:all .25s;
    border:1px solid var(--border);min-height:138px;overflow:hidden;
  }
  .sc:hover{transform:translateY(-3px);border-color:rgba(255,255,255,.25);}
  .sc:active{transform:scale(.97);}
  .sn{font-family:'Bebas Neue';font-size:28px;line-height:1;opacity:.35;}
  .sname{font-weight:900;font-size:12.5px;line-height:1.2;margin-top:3px;}
  .srange{font-size:9.5px;color:var(--muted);font-weight:800;margin-top:3px;}
  .sv{margin-top:7px;font-size:9px;padding:3px 7px;border-radius:999px;display:inline-block;font-weight:800;
    background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.12);}
  .sicon{position:absolute;top:8px;right:8px;font-size:16px;opacity:.7;}
  .c1{background:linear-gradient(160deg,#1e3a5f 0%,#061022 100%);}
  .c2{background:linear-gradient(160deg,#0f3d3d 0%,#031212 100%);}
  .c3{background:linear-gradient(160deg,#5c2a0f 0%,#1a0a04 100%);}
  .c4{background:linear-gradient(160deg,#4a1a1a 0%,#180404 100%);}
  .c5{background:linear-gradient(160deg,#2d1a4a 0%,#0b0418 100%);}
  .c6{background:linear-gradient(160deg,#3d3d0f 0%,#121203 100%);}
  .c7{background:linear-gradient(160deg,#0f2a4a 0%,#030d18 100%);}
  .c8{background:linear-gradient(160deg,#1a4a0f 0%,#051203 100%);}
  .c9{background:linear-gradient(160deg,#4a0f2a 0%,#18030d 100%);}
  .c10{background:linear-gradient(160deg,#4a3d0f 0%,#1a1603 100%);}
  .ev{padding:10px 10px 100px;display:none;}
  .ev.on{display:block;animation:fd .35s ease-out;}
  @keyframes fd{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
  .sh{padding:14px;border-radius:16px;margin-bottom:10px;position:relative;overflow:hidden;min-height:120px;}
  .sh::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.7),transparent 60%);}
  .sh > *{position:relative;z-index:2;}
  .bb{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;font-weight:900;padding:5px 9px;border-radius:999px;
    background:rgba(0,0,0,.45);cursor:pointer;border:1px solid rgba(255,255,255,.15);color:#fff;}
  .ec{display:flex;gap:9px;padding:9px 7px;border-radius:11px;cursor:pointer;transition:all .2s;border:1px solid transparent;margin-bottom:2px;}
  .ec:hover{background:var(--card);border-color:var(--border);}
  .et{width:104px;height:62px;border-radius:8px;flex-shrink:0;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;}
  .et b{font-family:'Bebas Neue';font-size:24px;opacity:.5;letter-spacing:1px;color:#fff;}
  .ed{position:absolute;right:5px;bottom:4px;font-size:8.5px;font-weight:900;background:rgba(0,0,0,.75);padding:2px 5px;border-radius:3px;color:#fff;}
  .eti{font-weight:900;font-size:12px;line-height:1.2;}
  .ede{font-size:10px;color:var(--muted);line-height:1.35;margin-top:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .etg{display:inline-block;font-size:8.5px;font-weight:900;padding:2px 6px;border-radius:4px;background:rgba(255,255,255,.08);margin-top:3px;}
  .xm{text-align:center;padding:14px 8px;font-size:11px;color:var(--muted);font-weight:800;border-top:1px dashed var(--border);margin-top:6px;letter-spacing:.5px;}
  .nav{position:absolute;left:0;right:0;bottom:0;background:rgba(4,4,10,.96);backdrop-filter:blur(20px);
    border-top:1px solid var(--border);padding:6px 2px 14px;display:flex;justify-content:space-around;z-index:50;}
  .ni{display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 8px;font-size:9px;font-weight:800;color:var(--muted);cursor:pointer;}
  .ni.on{color:#fff;}
  .ni.on i{background:linear-gradient(135deg,#eab308,#f97316,#a855f7,#3b82f6);
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .ni i{font-size:22px;}
  .ov{padding:10px 10px 100px;display:none;}
  .ov.on{display:block;}
  .player{position:fixed;inset:0;background:#000;z-index:999;display:none;flex-direction:column;}
  .player.on{display:flex;}
  .pvs{flex:1;position:relative;overflow:hidden;
    background:radial-gradient(ellipse at 30% 25%,rgba(59,130,246,.4),transparent 55%),
               radial-gradient(ellipse at 70% 75%,rgba(234,179,8,.25),transparent 50%),
               linear-gradient(135deg,#03030a,#0a0a20);
    display:flex;align-items:center;justify-content:center;}
  .pvs::before{content:'';position:absolute;inset:18% 8%;border:2px solid rgba(59,130,246,.55);border-radius:10px;
    box-shadow:0 0 70px rgba(59,130,246,.4),inset 0 0 50px rgba(59,130,246,.25);animation:sc 4.5s ease-in-out infinite;}
  @keyframes sc{50%{border-color:rgba(234,179,8,.65);box-shadow:0 0 70px rgba(234,179,8,.5),inset 0 0 50px rgba(234,179,8,.3);}}
  .pvt{font-family:'Bebas Neue';font-size:30px;letter-spacing:3px;text-align:center;padding:0 18px;position:relative;line-height:1.05;
    background:linear-gradient(135deg,#fff,#60a5fa,#fbbf24);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .pvsb{text-align:center;color:#93c5fd;font-size:10.5px;margin-top:10px;font-weight:900;letter-spacing:2px;position:relative;text-transform:uppercase;}
  .pb{height:4px;background:rgba(255,255,255,.15);border-radius:2px;overflow:hidden;}
  .pf{height:100%;width:0%;background:linear-gradient(90deg,#22c55e,#3b82f6,#a855f7,#f97316,#eab308);animation:pfa 260s linear forwards;border-radius:2px;}
  @keyframes pfa{to{width:100%;}}
  .card{padding:9px;border-radius:11px;background:var(--card);border:1px solid var(--border);margin-bottom:5px;}
  .chip{font-size:8.5px;font-weight:900;padding:2px 6px;border-radius:4px;}
  @media (max-width:480px){
    .wrap{padding:8px 2px;}
    .phone{border-radius:0;box-shadow:none;max-width:100%;}
    .notch{display:none;}
  }
</style>
</head>
<body>

<div class="wrap">
<div class="phone">
  <div class="notch"></div>
  <div class="sb"><span>9:41</span><div style="display:flex;gap:5px;align-items:center;"><i class="ri-signal-wifi-3-line"></i><i class="ri-battery-2-charge-line"></i></div></div>

  <div class="hero">
    <div style="display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2;">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:38px;height:38px;border-radius:11px;
          background:linear-gradient(135deg,#3b82f6,#a855f7,#f97316,#eab308);
          display:flex;align-items:center;justify-content:center;font-weight:900;font-size:15px;
          box-shadow:0 4px 20px rgba(234,179,8,.35);">PV</div>
        <div>
          <div style="font-weight:900;font-size:14px;line-height:1;">UNIVERSO PV</div>
